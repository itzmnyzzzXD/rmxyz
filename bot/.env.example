# === RM bot configuration ===
# Paste your Discord bot token here (Discord Developer Portal > Bot > Reset Token)
DISCORD_BOT_TOKEN=PUT_YOUR_BOT_TOKEN_HERE

# Your deployed dashboard URL (no trailing slash)
DASHBOARD_URL=https://rmxyz.vercel.app

# Shared key: must exactly match BOT_SYNC_KEY in Vercel
BOT_SYNC_KEY=PUT_YOUR_SYNC_KEY_HERE

# Optional
BOT_PREFIXES=rm!,rm?
BOT_OWNER_IDS=
