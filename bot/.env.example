# === RM bot configuration (VPS / container only) ===
DISCORD_BOT_TOKEN=PUT_YOUR_BOT_TOKEN_HERE
DASHBOARD_URL=https://rmxyz.vercel.app
BOT_SYNC_KEY=PUT_YOUR_SYNC_KEY_HERE
BOT_PREFIXES=rm!,rm?
BOT_OWNER_IDS=

